# Application & Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/card_monitor
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Source Mode: 'auto' (live with fallback to fixtures), 'fixtures' (offline fixtures only), 'live' (network only)
SOURCE_MODE=auto
FIXTURE_DIR=fixtures/sources

# AI Provider Selection: 'mock' | 'ollama' | 'openai' | 'openai-compatible'
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:3b
AI_TIMEOUT_MS=300000
AI_MAX_CONTENT_CHARS=3500
AI_SECOND_PASS=false

# Ollama Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=300000

# OpenAI-Compatible / Commercial AI Provider (Optional)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-proj-...
# AI_MODEL=gpt-4o-mini
# AI_INPUT_COST_PER_1M=0.15
# AI_OUTPUT_COST_PER_1M=0.60

# Scraper Settings
SCRAPER_USER_AGENT=CardDataMonitor/1.0 (+https://example.com/card-data-monitor)
SCRAPER_TIMEOUT_MS=20000
SCRAPER_CACHE_TTL_SECONDS=900
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BASE_MS=500
SCRAPER_MAX_CONTENT_CHARS=60000
SCRAPER_HOST_MIN_INTERVAL_MS=1500
SCRAPER_RESPECT_ROBOTS=true

# Daily Job Concurrency
MONITOR_CONCURRENCY=3

# Observability (NestJS Observe)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
